---
import { getCollection } from "astro:content";
import SocialLinks from "../components/SocialLinks.astro";

const posts = await getCollection("blog");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DiscussionBridge for Astro Demo</title>
    <meta name="description" content="Plain Astro demo for DiscussionBridge." />
  </head>
  <body>
    <header class="site-header">
      <a href="/">DiscussionBridge for Astro Demo</a>
      <nav aria-label="Product navigation">
        <a href="https://demo.discussionbridge.dev/">Demo hub</a>
        <a href="https://discussionbridge.dev/">DiscussionBridge.dev</a>
      </nav>
    </header>
    <main>
      <p>Plain Astro</p>
      <h1>DiscussionBridge for Astro Demo</h1>
      <p>
        A small non-Starlight Astro site proving DiscussionBridge can live in a regular Astro
        layout and content collection.
      </p>
      <ul>
        {posts.map((post) => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>)}
      </ul>
      <h2>Current bounded product</h2>
      <p>
        This reference uses the same current adapter package as the Astro + Starlight demo
        without importing the superseded navigation, source, or relationship estate.
      </p>
    </main>
    <footer><SocialLinks /></footer>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #fbfaf7;
    color: #232421;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.65;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    border-block-end: 1px solid #d9d6cf;
    background: #fff;
  }

  .site-header > a {
    color: #232421;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-header nav a {
    text-decoration: none;
  }

  main {
    width: min(760px, calc(100% - 2rem));
    margin: 0 auto;
    padding-block: 5rem;
  }

  p:first-child {
    color: #62665d;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.05;
  }

  a {
    color: #245f73;
  }

  footer { display: flex; justify-content: center; padding: 1.25rem 1rem 2rem; border-block-start: 1px solid #d9d6cf; }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
